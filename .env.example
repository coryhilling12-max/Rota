# ── Google OAuth (from Google Cloud Console → Credentials → OAuth client, "Desktop app") ──
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Filled in automatically after you run `npm run auth`
GOOGLE_REFRESH_TOKEN=

# ── The rota ──
# The Google Drive file id of the master rota (already correct for your sheet).
FILE_ID=13J4rn0fn-MYWDORNGd31O91avGcAWA7x
# The worksheet/tab inside the file that holds the live rota.
SHEET_NAME=ROTA
# Your name as shown to you in the app.
PERSON_NAME=Cory
# Which name-column labels are yours. This regex matches CORY + any role code
# (HVCA, SVN, NVCA, VCA, RVN, ...) so it keeps working when your role changes,
# without grabbing meeting notes. Edit only if your rota name changes.
PERSON_MATCH=^CORY\s+[A-Z]{2,6}$

# ── App ──
PORT=8080
# How often to re-sync automatically (cron syntax). Default: every 3 hours.
SYNC_CRON=0 */3 * * *
# Where the SQLite database file lives.
DB_PATH=./data/rota.db

# ── Login (Firebase Auth) ──
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the entire downloaded JSON file as a single line here.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# Only this Google account is allowed to sign in and see the app.
ALLOWED_EMAIL=your-email@gmail.com
